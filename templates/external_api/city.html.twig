<h1>Weather Forecast</h1>

{{ form_start(form) }}
{{ form_widget(form) }}
<button class="btn btn-primary">Submit</button>
{{ form_end(form) }}

{% if forecastData %}
    <h2>Data from Open Meteo</h2>
    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th>Max Temperature (°C)</th>
            <th>Min Temperature (°C)</th>
            <th>Precipitation (mm)</th>
        </tr>
        </thead>
        <tbody>
        {% for i in 0..forecastData.daily.time | length - 1 %}
            <tr>
                <td>{{ forecastData.daily.time[i] }}</td>
                <td>{{ forecastData.daily.temperature_2m_max[i] }}</td>
                <td>{{ forecastData.daily.temperature_2m_min[i] }}</td>
                <td>{{ forecastData.daily.precipitation_sum[i] }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
