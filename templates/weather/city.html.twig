{% extends 'base.html.twig' %}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for forecast in forecasts %}
                <li>
                    Date: {{ forecast.date|date('d.m.Y') }}<br>
                    Temperature: {{ forecast.celsius }}&deg;C<br>
                    Humidity: {{ forecast.humidity }}%<br>
                    Feels like: {{ forecast.feelsLike }}&deg;C
                </li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
