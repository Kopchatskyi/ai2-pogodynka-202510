{% autoescape false %}
{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d') }}",
            "celsius": {{ m.celsius|default(0) }},
            "fahrenheit": {{ m.fahrenheit|default(0) }},
            "humidity": {{ m.humidity|default(0) }},
            "feels_like": {{ m.feelsLike|default(0) }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
{% endautoescape %}
